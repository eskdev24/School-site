{
  "entities": {
    "ParentRegistration": {
      "title": "Parent Registration",
      "description": "Student registration submitted by parent",
      "type": "object",
      "properties": {
        "childName": { "type": "string" },
        "childAge": { "type": "string" },
        "schoolName": { "type": "string" },
        "location": { "type": "string" },
        "parentName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" },
        "timestampDisplay": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["childName", "parentName", "phone"]
    },
    "DemoBooking": {
      "title": "School Demo Booking",
      "description": "Free demonstration request from school administration",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "location": { "type": "string" },
        "contactPerson": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "estimatedStudents": { "type": "string" },
        "preferredDate": { "type": "string" },
        "additionalNotes": { "type": "string" },
        "status": { "type": "string" },
        "timestampDisplay": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolName", "contactPerson", "phone"]
    },
    "ContactInquiry": {
      "title": "Contact Inquiry",
      "description": "General inquiry message from website visitor",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "location": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "timestampDisplay": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "phone", "message"]
    }
  },
  "firestore": {
    "/parent_registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/ParentRegistration" },
      "description": "Collection of student registrations"
    },
    "/demo_bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/DemoBooking" },
      "description": "Collection of school demo bookings"
    },
    "/contact_inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Collection of contact inquiries"
    }
  }
}
